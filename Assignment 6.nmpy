import numpy as np

np.set_printoptions(precision=4, suppress=True)

print("Question 1")
temperature = np.array([25, 28, 31, 35, 38, 27, 33, 40])

corrected = temperature + 2
print("1(a) Readings after adding 2 degree Celsius:", corrected)

fahrenheit = corrected * 9 / 5 + 32
print("1(b) Readings in Fahrenheit:", fahrenheit)

mask = temperature > 32
print("1(c) Boolean result:", mask)
print("Readings greater than 32:", temperature[mask])
print("1(d) Number of readings greater than 32:", np.count_nonzero(mask))

print("1(e) Vectorization works on the complete array at once")
print("Boolean indexing directly selects the required values")

print("\nQuestion 2")
steps = np.array([
    [5000, 6200, 7100],
    [8000, 7500, 9000],
    [4500, 5100, 4800],
    [9000, 8500, 9500]
])

print("Steps:\n", steps)
print("2(a) Total steps:", np.sum(steps))
print("2(b) Mean steps:", np.mean(steps))
print("2(c) Maximum steps:", np.max(steps))
print("Minimum steps:", np.min(steps))
print("2(d) Total steps for each day:", np.sum(steps, axis=0))
print("2(e) Total steps for each user:", np.sum(steps, axis=1))

position = np.unravel_index(np.argmax(steps), steps.shape)
print("2(f) Position of maximum value:", position)
print("The maximum value belongs to user", position[0] + 1,
      "on day", position[1] + 1)

print("\nQuestion 3")
original = np.array([1, 2, 3, 4, 5, 6])
print("3(a) Original array:", original)

subset = original[1:5]
print("3(b) Subset:", subset)

subset[0] = 999
print("3(c) After changing subset")
print("Original:", original)
print("Subset:", subset)

copied_array = original[1:5].copy()
copied_array[0] = 500
print("3(d) After changing copied array")
print("Original:", original)
print("Copied array:", copied_array)

matrix = np.arange(1, 13).reshape(3, 4)
print("3(e) 3 by 4 matrix:\n", matrix)
print("3(f) First row:", matrix[0])
print("Last row:", matrix[-1])
print("Second column:", matrix[:, 1])
print("Rows 1 to 2 and columns 2 to 3:\n", matrix[1:3, 2:4])

flat_array = matrix.flatten()
ravel_array = matrix.ravel()
print("3(g) Using flatten:", flat_array)
print("Using ravel:", ravel_array)

ravel_array[0] = 999
print("3(h) Matrix after changing ravel array:\n", matrix)

flat_array[1] = 500
print("3(i) Matrix after changing flatten array:\n", matrix)

print("3(j) Shape:", matrix.shape)
print("Dimensions:", matrix.ndim)
print("Size:", matrix.size)
print("Data type:", matrix.dtype)

print("\nQuestion 4")
X = np.array([
    [6, 70, 3],
    [5, 50, 6],
    [8, 80, 2],
    [4, 30, 8]
], dtype=float)

y = np.array([40, 65, 30, 85], dtype=float)

print("4(a) Shape of X:", X.shape)
print("Dimensions of X:", X.ndim)

transpose = X.T
print("4(b) Transpose of X:\n", transpose)
print("The transpose changes the rows into columns")

product = X.T @ X
print("4(c) X transpose multiplied by X:\n", product)

inverse = np.linalg.inv(product)
print("4(d) Inverse:\n", inverse)

beta = inverse @ X.T @ y
print("4(e) Beta values:", beta)
print("4(f) These values show the effect of sleep activity and stress on the score")

new_user = np.array([5, 40, 7])
predicted_score = new_user @ beta
print("4(g) Predicted assistance score:", predicted_score)
